   "how": "exact",
   "old_string": "    def _collect_referenced_extras(\n        self,\n        markers: MarkerList,\n        extras: list[str],\n    ) -> None:\n        for item in markers:\n            if isinstance(item, list):\n                self._collect_referenced_extras(item, extras)\n            elif isinstance(item, tuple):\n                lhs, _op, rhs = item\n                if isinstance(lhs, Variable) and lhs.value == \"extra\":\n                    if isinstance(rhs, Value):\n                        extras.append(rhs.value)\n                elif isinstance(rhs, Variable) and rhs.value == \"extra\":\n                    if isinstance(lhs, Value):\n                        extras.append(lhs.value)\n        # The parsed tree is private, so its formatted text can be reused.\n        if self._serialized is None:\n            self._serialized = _format_marker(self._markers)\n        return self._serialized"
