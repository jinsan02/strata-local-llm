   "how": "exact",
   "old_string": "    def _collect_referenced_extras(\n        self, markers: MarkerList, extras: set[NormalizedName]\n    ) -> None:\n        \"\"\"Recursively collect extra names from a marker tree.\"\"\"\n        for item in markers:\n            if isinstance(item, str):\n                # \"and\" or \"or\" - skip\n                continue\n            if isinstance(item, list):\n                # Nested list (from parentheses)\n                self._collect_referenced_extras(item, extras)\n            elif isinstance(item, tuple):\n                # MarkerAtom: (lhs, op, rhs)\n                lhs, _op, rhs = item\n                if isinstance(lhs, Variable) and lhs.value == \"extra\":\n                    if isinstance(rhs, Value):\n                        extras.add(canonicalize_name(rhs.value))\n                elif isinstance(rhs, Variable) and rhs.value == \"extra\":\n                    if isinstance(lhs, Value):\n                        extras.add(canonicalize_name(lhs.value))"
