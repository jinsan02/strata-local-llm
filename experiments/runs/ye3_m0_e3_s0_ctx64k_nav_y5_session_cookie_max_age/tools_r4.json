   "new_chars": 1203,
   "how": "exact",
   "old_string": "    def get_cookie_max_age(\n        self, app: \"Flask\"\n    ) -> t.Optional[int]:\n        \"\"\"Returns the max age for the session cookie. The default\n        implementation returns the value of the\n        :data:`SESSION_COOKIE_MAX_AGE` setting.\n\n        If the value is ``None``, no ``Max-Age`` attribute will be set\n        and the cookie will become a session cookie (deleted when the\n        browser is closed).\n\n        If the value is an integer, it will be used as the max age in\n        seconds. If the value is a :class:`~datetime.timedelta`, it will\n        be converted to seconds.\n\n        .. versionadded:: 2.3\n        \"\"\"\n        from datetime import timedelta\n\n        rv = app.config[\"SESSION_COOKIE_MAX_AGE\"]\n        if rv is None:\n            return None\n        if isinstance(rv, timedelta):\n            rv = int(rv.total_seconds())\n        if not isinstance(rv, int):\n            raise TypeError(\"SESSION_COOKIE_MAX_AGE must be None, int, or timedelta\")\n        if rv < 0:\n            raise ValueError(\"SESSION_COOKIE_MAX_AGE must be non-negative\")\n        return rv"
  },
