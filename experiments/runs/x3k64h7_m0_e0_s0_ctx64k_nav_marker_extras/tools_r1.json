   "how": "exact",
   "old_string": "    def _collect_extras_from_atom(\n        self, atom: MarkerAtom, extras: set[NormalizedName]\n    ) -> None:\n        \"\"\"Extract extra names from a single marker atom (lhs op rhs).\"\"\"\n        lhs, op, rhs = atom\n\n        # Check if this comparison involves the 'extra' variable\n        lhs_is_extra = isinstance(lhs, Variable) and lhs.value == \"extra\"\n        rhs_is_extra = isinstance(rhs, Variable) and rhs.value == \"extra\"\n\n        if lhs_is_extra:\n            # extra == \"name\", extra != \"name\", etc.\n            if isinstance(rhs, Value):\n                extras.add(canonicalize_name(rhs.value))\n        elif rhs_is_extra:\n            # \"name\" == extra, \"name\" != extra, etc.\n            if isinstance(lhs, Value):\n                extras.add(canonicalize_name(lhs.value))\n        else:\n            # Check for \"name\" in extras / \"name\" not in extras\n            # The variable is on the right (extras), and lhs is a Value\n            if isinstance(rhs, Variable) and rhs.value in MARKERS_ALLOWING_SET:\n                if isinstance(lhs, Value):\n                    extras.add(canonicalize_name(lhs.value))"
