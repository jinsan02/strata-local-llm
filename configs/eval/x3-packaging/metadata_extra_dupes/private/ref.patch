+    def _check_requires_dist_extras(self) -> None:
+        """Every ``extra`` compared in a Requires-Dist marker is a Provides-Extra.
+
+        Uses only the values already validated (cached); skipped when either field
+        is absent or failed validation.
+        """
+        declared = self.__dict__.get("provides_extra")
+        reqs = self.__dict__.get("requires_dist")
+        if declared is None or not reqs:
+            return
+        known = set(declared)
+        for req in reqs:
+            if req.marker is None:
+                continue
+            for name in sorted(_marker_extra_values(req.marker._markers)):
+                if name not in known:
+                    raise InvalidMetadata(
+                        "requires-dist",
+                        f"{str(req)!r} uses extra {name!r} which is not in "
+                        f"'provides-extra'",
+                    )
