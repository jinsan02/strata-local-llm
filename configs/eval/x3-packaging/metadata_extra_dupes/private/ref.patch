+def _marker_extra_values(markers: object) -> set[str]:
+    """Normalized values compared with the ``extra`` variable in a marker tree."""
+    found: set[str] = set()
+    if isinstance(markers, list):
+        for item in markers:
+            found |= _marker_extra_values(item)
+    elif isinstance(markers, tuple) and len(markers) == 3:
+        lhs, _op, rhs = markers
+        if isinstance(lhs, Variable) and lhs.value == "extra" and isinstance(rhs, Value):
+            found.add(utils.canonicalize_name(rhs.value))
+        elif isinstance(rhs, Variable) and rhs.value == "extra" and isinstance(lhs, Value):
+            found.add(utils.canonicalize_name(lhs.value))
+    return found
