+    def referenced_extras(self) -> frozenset[NormalizedName]:
+        """Return the normalized extra names this marker compares against."""
+        found: set[str] = set()
+
+        def walk(items: object) -> None:
+            for item in items:  # type: ignore[attr-defined]
+                if isinstance(item, list):
+                    walk(item)
+                elif isinstance(item, tuple):
+                    lhs, _, rhs = item
+                    if isinstance(lhs, Variable) and lhs.value == "extra" and isinstance(rhs, Value):
+                        found.add(rhs.value)
+                    elif isinstance(rhs, Variable) and rhs.value in ("extra", "extras") and isinstance(lhs, Value):
+                        found.add(lhs.value)
+
+        walk(self._markers)
+        return frozenset(canonicalize_name(name) for name in found)
+
