+    def bump(self, part: str) -> Version:
+        """Return a new version with the given release component incremented."""
+        index = {"major": 0, "minor": 1, "micro": 2}.get(part)
+        if index is None:
+            raise ValueError(f"unknown version part: {part!r}")
+        release = list(self.release)
+        if len(release) <= index:
+            release.extend([0] * (index + 1 - len(release)))
+        release[index] += 1
+        for pos in range(index + 1, len(release)):
+            release[pos] = 0
+        text = ".".join(str(x) for x in release)
+        if self.epoch:
+            text = f"{self.epoch}!{text}"
+        return Version(text)
+
