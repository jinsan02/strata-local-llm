#!/bin/sh
# 커밋 메시지 규칙 집행. 본체는 tools/check_commit_msg.py.
# --staged: 계보 트레일러(Run-Id, Invalidates)를 이 커밋이 만들 트리(인덱스)의
# 원장과 대조한다. CI 도 같은 트리를 본다.
# python 이 없으면 최소한의 제목 형식만 sh 로 검사한다.
set -e
ROOT="$(git rev-parse --show-toplevel)"

for PY in "C:/ProgramData/anaconda3/envs/strata_local_llm/python.exe" python python3; do
    if [ -x "$PY" ] || command -v "$PY" >/dev/null 2>&1; then
        exec "$PY" "$ROOT/tools/check_commit_msg.py" --staged "$1"
    fi
done

echo "  (python 없음 — 제목 형식만 검사한다)" >&2
HEAD_LINE="$(head -n 1 "$1")"
case "$HEAD_LINE" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac
if ! printf '%s' "$HEAD_LINE" | grep -qE '^(record|fix|upgrade|feat|model|docs|chore|revert)\((env|engine|config|quant|bench|eval|infra|docs)\): .+'; then
    echo "" >&2
    echo "  커밋 거부 — 제목 형식: <type>(<scope>): <제목>" >&2
    echo "  규칙: docs/COMMIT_CONVENTION.md" >&2
    echo "" >&2
    exit 1
fi
exit 0
